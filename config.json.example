{
    "choose_browser": "patchright",
    "email_suffix": "@outlook.com",
    "proxy": "",
    "bot_protection_wait": 16,
    "max_captcha_retries": 16,
    "concurrent_flows": 3,
    "max_tasks": 6,
    "oauth2": {
        "enable_oauth2": true,
        "client_id": "",
        "redirect_url": "http://localhost:8000/token-tool/callback",
        "tenant": "consumers",
        "prompt": "consent",
        "Scopes": [
            "offline_access",
            "https://graph.microsoft.com/Mail.Read",
            "https://graph.microsoft.com/Mail.Send"
        ]
    },
    "playwright": {
        "browser_path": ""
    },
    "recovery_email": {
        "enabled": true,
        "max_code_attempts": 2,
        "hx_email": {
            "base_url": "http://localhost:5173/api/v1",
            "api_key": "Authorization: Bearer xxx",
            "username": "admin",
            "password": "admin",
            "request_timeout_seconds": 15,
            "code_timeout_seconds": 120,
            "poll_interval_seconds": 3,
            "caller_id": "outlook-register",
            "account_group": "OutlookRegister 自动注册",
            "account_group_color": "#238636"
        }
    },
    "proxy_rotation": {
        "enabled": true,
        "base_url": "http://127.0.0.1:64756",
        "timeout_seconds": 10,
        "max_rotate_retries": 6,
        "session_scoped": true,
        "post_registration_route": "upstream",
        "check_proxy": true,
        "exit_ip_endpoint": "https://api.ipify.org?format=json",
        "tokens": [
            {
                "token": "",
                "proxy": "http://127.0.0.1:7890"
            }
        ]
    },
    "info": "外层参数必须填写,内部参数可选.email_suffix参数只能是@outlook.com或者@hotmail.com.playwright可用性较差.并且使用playwright指纹浏览器要能过https://www.browserscan.net,否则请使用patchright.请本地搭建代理池."
}
